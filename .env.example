APP_NAME=Nexus MCP
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./nexus.db

GEMINI_API_KEY=
GROQ_API_KEY=

GITHUB_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub MCP Server
GITHUB_TOKEN=
GITHUB_API_TIMEOUT=15


# Google Calendar MCP Server
GOOGLE_ACCESS_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/oauth/callback
GOOGLE_CALENDAR_API_TIMEOUT=15



GOOGLE_ACCESS_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/oauth/callback
GOOGLE_CALENDAR_API_TIMEOUT=15

# LLM providers (Phase 6)
NEXUS_LLM_PROVIDER=ollama
NEXUS_LLM_MODEL=
NEXUS_LLM_TEMPERATURE=0.2
NEXUS_LLM_MAX_OUTPUT_TOKENS=1024
NEXUS_LLM_TIMEOUT_SECONDS=60
NEXUS_LLM_MAX_RETRIES=3
OLLAMA_BASE_URL=http://localhost:11434

# Agent memory (Phase 8)
NEXUS_MEMORY_DB_URL=sqlite:///./nexus_memory.db
# Optional: Qdrant for semantic search at scale (pip install nexus-mcp[qdrant])
QDRANT_URL=
